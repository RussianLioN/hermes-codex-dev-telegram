# Conservative admission: review new root paths before making them trackable.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/run-hermes
!/backup-hermes-oauth
!/update-hermes-stable
!/configure-hermes-pilot-ssh
!/configure-codex-sandbox
!/run-openspec
!/run-mempalace
!/openspec/
!/tasks/

# Approved pure policy slice only; do not admit arbitrary scripts or fixtures.
!/scripts/
/scripts/*
!/scripts/project_environment.py
!/tests/
/tests/*
!/tests/test_project_environment.py

# Shared project skills only; never installed tooling, research dumps or state.
!/.hermes/
/.hermes/*
!/.hermes/skills/
!/.agents/
/.agents/*
!/.agents/skills/

# Credentials/environment files, even inside admitted document/source trees.
.env*
*.env
*.env.*
.envrc
.auth/
.ssh/
.aws/
.gnupg/
secrets/
credentials/
auth.json
auth.json.*
credentials.json
credentials.json.*
.netrc
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Private/generated runtime material is not project source.
backups/
backup/
safety-snapshots/
logs/
sessions/
memories/
spool/
state/
cache/
.cache/
checkpoints/
reports/
council/
*.log
*.jsonl
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.zip
*.tar
*.tar.*
*.tgz
*.7z
*.age
*.enc

# Dependency trees and reproducible build/tool caches.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage*
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
