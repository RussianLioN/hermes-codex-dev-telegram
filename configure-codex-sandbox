#!/bin/zsh
set -euo pipefail

# Выполняется оператором на macOS. Сценарий передаётся аргументом команды SSH,
# поэтому стандартный ввод остаётся подключённым к терминалу для запроса sudo.
remote_script_base64=''
exec ssh -tt hermes-codex-pilot "printf %s '$remote_script_base64' | base64 -d | /bin/bash"
